# ============================================================================
# Daivik Vastram WhatsApp Automation - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# Application Environment
# Options: development, production
NODE_ENV=production

# Server Configuration
PORT=3000

# ============================================================================
# Meta WhatsApp Cloud API Configuration
# Get these from: https://developers.facebook.com/docs/whatsapp/cloud-api/
# ============================================================================

# WhatsApp Business Account Phone Number ID
# From: Meta Business Suite -> WhatsApp > Settings > Phone number ID
WHATSAPP_PHONE_NUMBER_ID=1262319210295848

# WhatsApp Cloud API Access Token
# From: Meta Business Suite -> WhatsApp > Settings > API Tokens
# Keep this secure! Use Firebase Secrets in production
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Meta Graph API Version (optional, defaults to v23.0)
# Check: https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_API_VERSION=v23.0

# ============================================================================
# WhatsApp Template Configuration
# ============================================================================

# Mata Rani Template Image URL
# Must be: Public URL, HTTPS, <5MB, JPG/PNG/WebP format
# The image displayed in the WhatsApp template header
# Example from Shopify store:
MATA_RANI_IMAGE_URL=https://cdn.shopify.com/s/files/1/0971/8107/3775/files/Mata_Rani_Dress_Banner.png?v=1790630375

# ============================================================================
# Webhook Configuration (for incoming messages/webhooks)
# ============================================================================

# Webhook verification token (for Meta webhook requests)
# Generate a random string and use it in Meta webhook settings
WHATSAPP_VERIFY_TOKEN=daivik_whatsapp_2026

# ============================================================================
# Firebase Configuration
# Get these from: Firebase Console -> Project Settings
# ============================================================================

# Firebase credentials - typically from service account JSON
# Option 1: Store full JSON in FIREBASE_CONFIG
# Option 2: Use individual Firebase env vars below
# For production, use Firebase Secret Manager

# FIREBASE_CONFIG={full_json_here}

# Or individual Firebase settings:
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ============================================================================
# Shopify Configuration (if using Shopify integration)
# Get these from: Shopify Admin -> Apps and Integrations
# ============================================================================

SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_STORE_DOMAIN=your_store.myshopify.com

# ============================================================================
# Production Deployment Notes
# ============================================================================
# 1. Never store plain tokens in .env in production
# 2. Use cloud secret managers:
#    - Firebase Secret Manager
#    - AWS Secrets Manager
#    - Google Cloud Secret Manager
# 3. Set NODE_ENV=production for production deployments
# 4. Enable HTTPS only for API endpoints
# 5. Keep WHATSAPP_ACCESS_TOKEN and SHOPIFY_CLIENT_SECRET secure
# ============================================================================
